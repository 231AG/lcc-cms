# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Local development database (docker-compose.yml), or point this at your
# Supabase project's connection string (pooler, transaction mode) instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/lcc_eportal_dev"

# Supabase project values (dashboard > Project Settings > API).
# NEXT_PUBLIC_* values are safe for the browser. SUPABASE_SERVICE_ROLE_KEY
# is a server-only secret and must never be exposed to client code or logs.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Africa/Monrovia is the institutional display timezone; data is stored UTC.
INSTITUTION_TIMEZONE="Africa/Monrovia"
